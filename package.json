{
  "name": "essinghigh-splunk-datasource",
  "version": "0.2.0",
  "description": "Query Splunk from Grafana dashboards, Explore, variables, and alerting.",
  "scripts": {
    "build": "yarn build:frontend && yarn build:backend",
    "build:frontend": "webpack -c ./webpack.config.ts --env production",
    "build:backend": "./scripts/build-backend.sh",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn run lint --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "yarn dev",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "watch": "yarn dev",
    "test:ci": "jest --ci --runInBand",
    "e2e": "playwright test",
    "e2e:mock": "node scripts/mock-splunk.mjs",
    "build:release": "yarn build:frontend && ./scripts/build-backend.sh --all",
    "package": "./scripts/package-plugin.sh"
  },
  "author": "essinghigh (henry@essinghigh.dev)",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@grafana/e2e-selectors": "13.3.0",
    "@grafana/eslint-config": "9.0.0",
    "@grafana/plugin-e2e": "4.0.0",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.65.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@swc/core": "^1.16.21",
    "@swc/helpers": "^0.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-jsdoc": "^50.7.1",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "^5.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^14.0.4",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "monaco-editor-core": "0.57.0",
    "playwright-core": "1.65.0",
    "prettier": "^3.9.10",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "rxjs": "7.8.2",
    "sass": "1.107.1",
    "sass-loader": "16.0.5",
    "serialize-javascript": "7.1.4",
    "style-loader": "4.0.0",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.3.0",
    "@grafana/plugin-ui": "0.17.10",
    "@grafana/runtime": "13.3.0",
    "@grafana/schema": "13.3.0",
    "@grafana/ui": "13.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "resolutions": {
    "dompurify": "3.4.17",
    "copy-webpack-plugin/serialize-javascript": "7.1.4",
    "moment": "2.31.0"
  },
  "packageManager": "yarn@4.18.1"
}
